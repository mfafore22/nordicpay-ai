# .dockerignore
#
# Files and directories to exclude from Docker build context.
# This makes builds faster and images smaller.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env.local
*.egg-info/
dist/
build/

# Node (frontend)
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*
.docker/

# Documentation
*.md
!README.md
docs/

# Testing
tests/
*.test.py
.pytest_cache/
.coverage

# Misc
*.log
*.tmp
.DS_Store
Thumbs.db

# Large files (mount as volumes instead)
# nordic-bank-model/